rules_version = '2';

// Muscle Coach — Firestore Security Rules.
// Prinsip: default deny. Pengguna hanya mengakses dokumen di bawah
// users/{uid} miliknya; dokumen hasil kalkulasi/AI ditulis Cloud Functions
// (Admin SDK melewati rules). Subkoleksi baru ditambahkan per fase.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Hanya field yang disebut yang boleh berubah.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function stampedNow() {
      return request.resource.data.updatedAt == request.time;
    }

    function optionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function optionalInt(value, min, max) {
      return value == null || (value is int && value >= min && value <= max);
    }

    // Sesi latihan ditulis aplikasi. `planned` = salinan target dari program
    // (tidak boleh diubah); hasil aktual disimpan terpisah di subkoleksi `sets`.
    function validSessionFields(d) {
      return d.keys().hasOnly(['planId', 'dayId', 'date', 'weekday', 'focus', 'status', 'planned',
          'startedAt', 'completedAt', 'notes', 'energy', 'discomfort', 'schemaVersion', 'updatedAt'])
        && d.planId is string && d.planId.size() <= 128
        && d.dayId is string && d.dayId.size() <= 16
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.weekday is int && d.weekday >= 1 && d.weekday <= 7
        && d.focus is string && d.focus.size() <= 32
        && d.status in ['in_progress', 'completed', 'skipped']
        && d.planned is list && d.planned.size() >= 1 && d.planned.size() <= 10
        && optionalString(d.get('notes', null), 500)
        && optionalString(d.get('discomfort', null), 300)
        && optionalInt(d.get('energy', null), 1, 5)
        && d.schemaVersion == 1
        && stampedNow();
    }

    function validSet(d) {
      return d.keys().hasOnly(['exerciseId', 'exerciseIndex', 'setNumber', 'weightKg', 'reps', 'rir',
          'status', 'loggedAt', 'schemaVersion', 'updatedAt'])
        && d.keys().hasAll(['exerciseId', 'exerciseIndex', 'setNumber', 'reps', 'status', 'schemaVersion', 'updatedAt'])
        && d.exerciseId is string && d.exerciseId.size() <= 64
        && d.exerciseIndex is int && d.exerciseIndex >= 0 && d.exerciseIndex <= 9
        && d.setNumber is int && d.setNumber >= 1 && d.setNumber <= 10
        && (d.get('weightKg', null) == null
            || ((d.weightKg is int || d.weightKg is float) && d.weightKg >= 0 && d.weightKg <= 1000))
        && d.reps is int && d.reps >= 0 && d.reps <= 300
        && optionalInt(d.get('rir', null), 0, 10)
        && d.status in ['done', 'skipped']
        && d.schemaVersion == 1
        && stampedNow();
    }

    // Draft assessment: struktur amplop dibatasi; isi divalidasi penuh oleh
    // Cloud Function `submitAssessment` saat dikirim.
    function validAssessmentDraft() {
      let d = request.resource.data;
      return d.keys().hasOnly(['status', 'schemaVersion', 'step', 'data', 'updatedAt'])
        && d.keys().hasAll(['status', 'schemaVersion', 'step', 'data', 'updatedAt'])
        && d.status == 'draft'
        && d.schemaVersion == 1
        && d.step is int && d.step >= 0 && d.step <= 6
        && d.data is map
        && d.data.keys().hasOnly(['profile', 'goal', 'experience', 'availability', 'activity', 'nutrition', 'safety'])
        && stampedNow();
    }

    match /users/{uid} {
      // Dibuat oleh `createUserProfile`, dihapus oleh `deleteUserData`.
      allow read: if isOwner(uid);
      allow write: if false;

      match /profile/current {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && onlyChanges(['displayName', 'updatedAt'])
          && optionalString(request.resource.data.displayName, 40)
          && stampedNow();
        allow create, delete: if false;
      }

      // Assessment final ditulis server; client hanya menulis dokumen `draft`.
      match /assessments/{assessmentId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && assessmentId == 'draft' && validAssessmentDraft();
        allow delete: if isOwner(uid) && assessmentId == 'draft';
      }

      // Hasil kalkulasi server & catatan persetujuan: baca saja.
      match /goals/{goalId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /nutritionTargets/{targetId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /consents/{consentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /equipment/current {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Program latihan dibuat & diaktifkan oleh Cloud Functions.
      match /workoutPlans/{planId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /days/{dayId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      match /workoutSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && validSessionFields(request.resource.data)
          && request.resource.data.status == 'in_progress'
          && request.resource.data.startedAt == request.time
          && request.resource.data.get('completedAt', null) == null;
        allow update: if isOwner(uid)
          && validSessionFields(request.resource.data)
          && onlyChanges(['status', 'completedAt', 'notes', 'energy', 'discomfort', 'updatedAt'])
          && (request.resource.data.status != 'completed'
              || resource.data.status == 'completed'
              || request.resource.data.completedAt == request.time);
        allow delete: if isOwner(uid);

        match /sets/{setId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && validSet(request.resource.data);
        }
      }

      // Placeholder subscription; hanya server yang menulis.
      match /entitlement/current {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Kuota & pemakaian AI: hanya server.
    match /usage/{uid} {
      allow read, write: if false;
    }

    // Katalog referensi global: baca saja, hanya yang sudah dipublikasikan.
    match /exerciseCatalog/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }

    match /foodCatalog/{id} {
      allow read: if signedIn() && resource.data.status == 'published';
      allow write: if false;
    }

    // Konfigurasi non-secret.
    match /appConfig/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}

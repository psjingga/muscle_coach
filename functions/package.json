{
  "name": "musclecoach-functions",
  "private": true,
  "description": "Cloud Functions Muscle Coach (TypeScript)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:emulator": "../tool/firebase.sh emulators:exec --project demo-musclecoach --only auth,firestore \"vitest run --project emulator\"",
    "serve": "npm run build && ../tool/firebase.sh emulators:start --project demo-musclecoach",
    "deploy": "../tool/firebase.sh deploy --only functions",
    "seed:emulator": "npm run build && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=demo-musclecoach node lib/catalog/seedCli.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.0.0",
    "firebase": "^13.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: data kesehatan & API key TIDAK ikut cadangan cloud (Google Drive).
     Pindah perangkat langsung (kabel/Wi-Fi, terenkripsi) boleh membawa basis data;
     API key tidak, karena kuncinya terikat Android Keystore perangkat lama. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
